{%- comment -%}
  Local override of al_folio_core's _includes/header.liquid (v1.0.15) that adds a language switcher.
  - Pages declare `lang: en` or `lang: de` (default: site.lang). The navbar only lists pages of the current language.
  - Pages may declare `translations: {en: <url>, de: <url>}` so the switcher jumps to the matching page.
  - The Japanese entry always points to /jp/ (an access-restricted placeholder page).
  If you upgrade al_folio_core, diff this file against the gem's header.liquid.
{%- endcomment -%}
{%- assign cur_lang = page.lang | default: site.lang | default: 'en' -%}
{%- if cur_lang == 'de' -%}
  {%- assign home_url = '/de/' -%}
{%- else -%}
  {%- assign home_url = '/' -%}
{%- endif -%}
{%- assign en_url = page.translations.en | default: '/' -%}
{%- assign de_url = page.translations.de | default: '/de/' -%}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for home_page in site.pages %}
            {% if home_page.permalink == home_url %} {% assign about_title = home_page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- about_title }}
              {% if page.permalink == home_url %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages in the current language -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: site.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and p_lang == cur_lang %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="nav-link" href="{{ url | relative_url }}">
                  {{- p.title }}
                  {% if page.url contains p.url %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <!-- Language switcher -->
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              id="languageDropdown"
              role="button"
              data-nav-dropdown-toggle="true"
              aria-haspopup="true"
              aria-expanded="false"
              title="Language"
            >
              <i class="fa-solid fa-language"></i>
              {{ cur_lang | upcase }}
            </a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="languageDropdown">
              <a class="dropdown-item {% if cur_lang == 'en' %}active{% endif %}" href="{{ en_url | relative_url }}" hreflang="en" lang="en">English</a>
              <a class="dropdown-item {% if cur_lang == 'de' %}active{% endif %}" href="{{ de_url | relative_url }}" hreflang="de" lang="de">Deutsch</a>
              <a class="dropdown-item" href="{{ '/jp/' | relative_url }}" hreflang="ja" lang="ja">日本語</a>
            </div>
          </li>

          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
